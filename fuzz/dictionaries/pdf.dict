# Page content operators.
op_text_begin="BT\x0a"
op_text_end="ET\x0a"
op_font="/F1 12 Tf\x0a"
op_move="72 700 Td\x0a"
op_show="(text) Tj\x0a"
op_show_array="[(a) -250 (b)] TJ\x0a"
op_save="q\x0a"
op_restore="Q\x0a"
op_matrix="1 0 0 1 0 0 cm\x0a"
op_rect="0 0 100 100 re\x0a"
op_fill="f\x0a"
op_stroke="S\x0a"
op_clip="W n\x0a"
