# PDF syntax for the engine target: header, keywords the reader acts on, and the values that
# have given PDF readers trouble elsewhere. Strings are kept to what PDFium parses.

header_17="%PDF-1.7\x0a"
header_20="%PDF-2.0\x0a"
header_14="%PDF-1.4\x0a"
eof="%%EOF"
obj=" 0 obj\x0a"
endobj="endobj\x0a"
stream="stream\x0a"
endstream="\x0aendstream"
xref="xref\x0a"
trailer="trailer\x0a"
startxref="startxref\x0a"
dict_open="<<"
dict_close=">>"
array_open="["
array_close="]"
ref=" 0 R"

