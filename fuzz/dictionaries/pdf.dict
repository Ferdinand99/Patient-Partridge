op_id="ID\x0a"
op_ei="EI\x0a"

# Numbers that break size and offset arithmetic.
num_max="2147483647"
num_over="2147483648"
num_big="4294967295"
num_neg="-2147483648"
num_real_big="99999999999999999999"
num_real_small="0.0000000001"
num_nan_like="1e400"
num_neg_one="-1"
box_huge="[0 0 14400 14400]"
box_zero="[0 0 0 0]"
box_neg="[100 100 0 0]"
box_inf="[0 0 99999999 99999999]"
