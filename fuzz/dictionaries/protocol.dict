# Patient Partridge protocol. Request tags (1 to 24, 40 to 42, 60, 80 to 91), answer tags (129 to 146,
# 170, 171, 190, 200 to 205, 255), the presence byte of an optional string, error codes, link kinds, and the numbers where the
# decoders have limits (little endian u32).

req_hello="\x01"
req_open="\x02"
req_render="\x03"
req_close="\x04"
req_outline="\x05"
req_page_text="\x06"
req_page_links="\x07"
req_search="\x08"
req_font_report="\x09"
req_doc_info="\x0a"
req_save_begin="\x0b"
req_save_chunk="\x0c"
req_save_end="\x0d"
req_fingerprint="\x0e"
req_list_annots="\x0f"
req_add_markup="\x10"
req_add_note="\x11"
req_add_ink="\x12"
req_add_stamp="\x13"
req_update_annot="\x14"
req_remove_annot="\x15"
req_restore_annot="\x16"
req_add_signature="\x17"
req_place_signature="\x18"

# The page tools: request tags 80 to 91, answer tags 200 to 205.
req_pages_delete="\x50"
req_pages_reorder="\x51"
req_pages_rotate="\x52"
req_pages_crop="\x53"
req_pages_set_boxes="\x54"
req_pages_insert_blank="\x55"
req_pages_restore="\x56"
req_import_begin="\x57"
req_import_chunk="\x58"
req_import_end="\x59"
req_import_abort="\x5a"
req_export_begin="\x5b"
res_pages_changed="\xc8"
res_pages_cropped="\xc9"
res_import_ready="\xca"
res_import_ack="\xcb"
res_exported="\xcc"
res_pages_done="\xcd"
# Error codes of the page tools (50 to 56).
err_too_many_pages="\x32"
err_busy="\x36"
err_insert_source_failed="\x37"
err_pages_not_allowed="\x38"

res_hello="\x81"
res_opened="\x82"
res_rendered="\x83"
res_closed="\x84"
res_outline="\x85"
res_page_text="\x86"
res_page_links="\x87"
res_matches="\x88"
res_font_report="\x89"
res_doc_info="\x8a"
res_save_ready="\x8b"
res_save_data="\x8c"
res_save_ended="\x8d"
res_progress="\x8e"
res_fingerprint="\x8f"
res_annots="\x90"
res_annot="\x91"
res_annot_removed="\x92"
res_error="\xff"

# A message starts with a tag and a request id.
tag_id_0="\x03\x00\x00\x00\x00"
tag_id_max="\x03\xff\xff\xff\xff"

opt_absent="\x00"
opt_present="\x01"
link_uri="\x00"
link_page="\x01"
error_code_last="\x0c"
error_code_past="\x0d"
depth_max="\x0f"
depth_past="\x10"

# Numbers that are limits or sit next to one.
zero="\x00\x00\x00\x00"
one="\x01\x00\x00\x00"
u32_max="\xff\xff\xff\xff"
no_page="\xff\xff\xff\xff"
u32_max_minus_one="\xfe\xff\xff\xff"
len_16384="\x00\x40\x00\x00"
len_16385="\x01\x40\x00\x00"
len_24m="\x00\x36\x6e\x01"
len_256="\x00\x01\x00\x00"
len_257="\x01\x01\x00\x00"
len_512="\x00\x02\x00\x00"
len_513="\x01\x02\x00\x00"
len_2048="\x00\x08\x00\x00"
len_2049="\x01\x08\x00\x00"
len_64k="\x00\x00\x01\x00"
len_64k_plus_1="\x01\x00\x01\x00"
count_500="\xf4\x01\x00\x00"
count_501="\xf5\x01\x00\x00"
count_2000="\xd0\x07\x00\x00"
count_2001="\xd1\x07\x00\x00"
count_5000="\x88\x13\x00\x00"
count_5001="\x89\x13\x00\x00"
count_100k="\xa0\x86\x01\x00"
count_100k_plus_1="\xa1\x86\x01\x00"
bytes_400k="\x80\x1a\x06\x00"
frame_128m="\x00\x00\x00\x08"
frame_128m_plus_1="\x01\x00\x00\x08"

# Floats: 1.0, -1.0, NaN, +infinity, -infinity, the largest finite number.
f32_one="\x00\x00\x80\x3f"
f32_minus_one="\x00\x00\x80\xbf"
f32_nan="\x00\x00\xc0\x7f"
f32_inf="\x00\x00\x80\x7f"
f32_minus_inf="\x00\x00\x80\xff"
f32_max="\xff\xff\x7f\x7f"

# Text: a two, a three and a four byte character, and the first bytes of each cut short.
utf8_2="\xc3\xa5"
utf8_3="\xe2\x9c\x93"
utf8_4="\xf0\x9f\x93\x95"
utf8_cut_2="\xc3"
utf8_cut_4="\xf0\x9f\x93"
utf8_bad="\xff\xfe"

req_signatures="\x3c"
res_signatures="\xbe"

# Forms: request tags 40 to 42, answer tags 170 and 171, the three kinds of value of a change,
# the error codes 24 and 25, and the caps of the field lists (512, 8192, 500, 1000, 256).
req_form_info="\x28"
req_list_form_fields="\x29"
req_set_form_field="\x2a"
res_form_info="\xaa"
res_form_fields="\xab"
form_value_text="\x01"
form_value_checked="\x02"
form_value_choice="\x03"
error_code_form_unsupported="\x18"
error_code_form_refused="\x19"
error_code_form_past="\x1a"
form_name_cap="\x00\x02\x00\x00"
form_name_cap_plus_1="\x01\x02\x00\x00"
form_value_cap="\x00\x20\x00\x00"
form_value_cap_plus_1="\x01\x20\x00\x00"
form_options_cap="\xf4\x01\x00\x00"
form_options_cap_plus_1="\xf5\x01\x00\x00"
form_fields_cap="\xe8\x03\x00\x00"
form_fields_cap_plus_1="\xe9\x03\x00\x00"
form_label_cap_plus_1="\x01\x01\x00\x00"
