{
  "name": "patient-partridge",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "An open source PDF reader and editor: fast, small, no account, no cloud, no tracking",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "node node_modules/typescript-native/bin/tsc --noEmit",
    "lint": "eslint src scripts e2e vite.config.ts eslint.config.js",
    "test": "vitest run",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "tauri": "tauri",
    "fetch:pdfium": "node scripts/fetch-pdfium.mjs",
    "prepare:dev": "node scripts/prepare-dev.mjs",
    "bundle": "node scripts/prepare-bundle.mjs && tauri build --config src-tauri/tauri.bundle.generated.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.4",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "typescript-native": "npm:typescript@7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
