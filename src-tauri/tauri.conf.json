{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Patient Partridge",
  "version": "0.3.0",
  "identifier": "com.ferdinand99.patientpartridge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Patient Partridge",
        "width": 1000,
        "height": 800,
        "minWidth": 480,
        "minHeight": 360,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "freezePrototype": true,
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "msi",
      "nsis",
      "dmg",
      "app",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "An open source PDF reader and editor",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD-PARTY-NOTICES": "THIRD-PARTY-NOTICES"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "desktopTemplate": "partridge.desktop",
        "files": {
          "/usr/share/doc/patient-partridge/copyright": "../LICENSE",
          "/usr/share/doc/patient-partridge/THIRD-PARTY-NOTICES": "../THIRD-PARTY-NOTICES"
        }
      }
    },
    "windows": {
      "wix": {
        "language": "en-US",
        "fragmentPaths": [
          "wix/package-access.wxs"
        ],
        "componentGroupRefs": [
          "PackageAccessGroup"
        ]
      },
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF document",
        "description": "PDF document",
        "mimeType": "application/pdf",
        "role": "Viewer",
        "rank": "Alternate",
        "contentTypes": [
          "com.adobe.pdf"
        ]
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Ferdinand99/Patient-Partridge/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGOTJGMTJBNDZGMDY0NDgKUldSSVpQQkdLdkdTUDQ1T01NTzI5MVcvVzZvM21VcVBBWU1nZkh2enNicUVucXFMNjlRMm1qMXMK",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
